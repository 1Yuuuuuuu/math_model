{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "gate", "selected_option", "rationale", "artifact_ids", "decided_by", "decided_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_id": {"type": "string", "pattern": "^dec_[a-z0-9][a-z0-9_-]{2,63}$"},
    "gate": {"enum": ["gate_1_problem", "gate_2_model", "gate_3_outline", "gate_4_submission"]},
    "selected_option": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}$"}
    },
    "decided_by": {"const": "human"},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
