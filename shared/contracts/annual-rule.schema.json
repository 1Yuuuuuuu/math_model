{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/annual-rule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_set_id", "year", "source_url", "verified_at", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "rule_set_id": {"type": "string", "pattern": "^cumcm-[a-z0-9][a-z0-9-]{2,63}$"},
    "year": {"type": "integer", "minimum": 2000},
    "source_url": {"type": "string", "format": "uri", "pattern": "^(?![^\\r\\n]*[\\r\\n])https?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]+)?(?:[/?#][^\\s]*)?$"},
    "verified_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "description", "enforcement", "blocking"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^rule_[a-z0-9][a-z0-9_-]{2,63}$"},
          "description": {"type": "string", "minLength": 1},
          "enforcement": {"enum": ["machine", "human"]},
          "blocking": {"type": "boolean"}
        }
      }
    }
  }
}
