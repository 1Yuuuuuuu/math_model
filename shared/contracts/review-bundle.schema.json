{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/review-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "report_ids", "report_digests", "reviewed_artifact_ids", "readiness", "open_blocking_findings", "errors", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "pattern": "^review_bundle_[a-f0-9]{16}(?![\\s\\S])"},
    "report_ids": {"$ref": "#/$defs/report_ids"},
    "report_digests": {"$ref": "#/$defs/report_digests"},
    "reviewed_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^art_[a-z0-9][a-z0-9_-]{2,63}(?![\\s\\S])"}
    },
    "readiness": {"enum": ["ready_for_phase_6", "not_ready", "blocked"]},
    "open_blocking_findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^finding_[a-z0-9][a-z0-9_-]{2,63}(?![\\s\\S])"}},
    "errors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "report_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission", "reproducibility", "model", "paper", "red_team"],
      "properties": {
        "submission": {"type": ["string", "null"], "pattern": "^review_[a-f0-9]{16}(?![\\s\\S])"},
        "reproducibility": {"type": ["string", "null"], "pattern": "^review_[a-f0-9]{16}(?![\\s\\S])"},
        "model": {"type": ["string", "null"], "pattern": "^review_[a-f0-9]{16}(?![\\s\\S])"},
        "paper": {"type": ["string", "null"], "pattern": "^review_[a-f0-9]{16}(?![\\s\\S])"},
        "red_team": {"type": ["string", "null"], "pattern": "^review_[a-f0-9]{16}(?![\\s\\S])"}
      }
    },
    "report_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission", "reproducibility", "model", "paper", "red_team"],
      "properties": {
        "submission": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
        "reproducibility": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
        "model": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
        "paper": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
        "red_team": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}(?![\\s\\S])"}
      }
    }
  }
}
