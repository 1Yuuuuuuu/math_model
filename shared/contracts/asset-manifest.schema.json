{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/contracts/asset-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "assets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_version": {"const": "1.0"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "source_path", "sha256", "package_targets"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^asset_[a-z0-9][a-z0-9_-]{2,63}(?![\\s\\S])"},
          "source_path": {
            "type": "string",
            "allOf": [
              {"pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*[<>:\"|?*])(?!.*[\\u0000-\\u001F\\u007F-\\u009F])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*[. ](?:/|(?![\\s\\S]))).+(?![\\s\\S])"},
              {
                "if": {"pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*[<>:\"|?*])(?!.*[\\u0000-\\u001F\\u007F-\\u009F])(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|(?![\\s\\S])))(?!.*[. ](?:/|(?![\\s\\S]))).+(?![\\s\\S])"},
                "then": {"format": "cumcm-workspace-path"}
              }
            ]
          },
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
          "package_targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["codex", "dsh"]}
          }
        }
      }
    }
  }
}
