{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm.local/knowledge/model-card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_id", "category", "title", "file", "status", "priority", "required_sections"],
  "properties": {
    "model_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "category": {"enum": ["data", "evaluation", "prediction", "optimization", "classification", "statistics"]},
    "title": {"type": "string", "minLength": 1},
    "file": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "approved"]},
    "priority": {"type": "integer", "minimum": 1, "maximum": 3},
    "required_sections": {"type": "array", "minItems": 17, "items": {"type": "string"}}
  }
}
